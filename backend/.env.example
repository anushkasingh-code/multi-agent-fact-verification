# ==============================================================================
# Autonomous Multi-Agent Research & Fact Verification System - Environment Template
# Copy this file to '.env' and fill in your confidential API keys and credentials.
# DO NOT COMMIT ACTUAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# Project General Settings
PROJECT_NAME="Autonomous Multi-Agent Research & Fact Verification System"
API_V1_STR="/api/v1"
DEBUG=false

# Default LLM Provider ('groq', 'claude', 'openai', or 'gemini')
LLM_PROVIDER=groq
DEFAULT_LLM_PROVIDER=groq

# LLM API Keys (Replace placeholder values with your actual secret API keys)
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# LLM Model Identifiers
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_NAME=llama-3.3-70b-versatile
CLAUDE_MODEL_NAME=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_NAME=gpt-4o
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_NAME=gemini-2.5-flash

# Web Search Provider API Key (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# HuggingFace Token (Optional)
HF_TOKEN=your_huggingface_token_here

# Embedding Model (SentenceTransformers local model identifier)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# MongoDB Atlas Connection Configuration
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB_NAME=fact_verification_db
MONGODB_COLLECTION_NAME=research_analyses
