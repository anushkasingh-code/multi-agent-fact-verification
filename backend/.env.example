# ==============================================================================
# Autonomous Multi-Agent Research & Fact Verification System - Environment Configuration
# ==============================================================================

# Project General Settings
PROJECT_NAME="Autonomous Multi-Agent Research & Fact Verification System"
API_V1_STR="/api/v1"
DEBUG=false

# Default LLM Provider ('claude', 'openai', or 'gemini')
DEFAULT_LLM_PROVIDER="openai"

# LLM API Keys
# At least one LLM key is required (Claude, OpenAI, or Gemini)
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-key-here"
OPENAI_API_KEY="sk-proj-your-openai-key-here"
GOOGLE_API_KEY="your-google-api-key-here"

# LLM Model Identifiers
CLAUDE_MODEL_NAME="claude-3-5-sonnet-20241022"
OPENAI_MODEL_NAME="gpt-4o"
GEMINI_MODEL_NAME="gemini-2.5-flash"

# Web Search Provider API Key (Tavily)
TAVILY_API_KEY="tvly-your-tavily-api-key-here"

# Embedding Model (SentenceTransformers local model identifier)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"

# MongoDB Atlas Connection Configuration
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="fact_verification_db"
MONGODB_COLLECTION_NAME="research_analyses"
